{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "resolveJsonModule": true,
    "typeRoots": [
      "node_modules/@types",
      "manual_typings"
    ],
    "paths": {
      "@angular/*": [
        "./node_modules/@angular/*"
      ],
      "lodash/*": [
        "node_modules/@types/lodash-es/*"
      ],
      "@stulz/ajsf-core": [
        "dist/stulz/ajsf-core"
      ],
      "@stulz/ajsf-core/*": [
        "dist/stulz/ajsf-core/*"
      ],
      "@stulz/ajsf-bootstrap3": [
        "dist/stulz/ajsf-bootstrap3"
      ],
      "@stulz/ajsf-bootstrap3/*": [
        "dist/stulz/ajsf-bootstrap3/*"
      ],
      "@stulz/ajsf-bootstrap4": [
        "dist/stulz/ajsf-bootstrap4"
      ],
      "@stulz/ajsf-bootstrap4/*": [
        "dist/stulz/ajsf-bootstrap4/*"
      ],
      "@stulz/ajsf-bootstrap5": [
        "dist/stulz/ajsf-bootstrap5"
      ],
      "@stulz/ajsf-bootstrap5/*": [
        "dist/stulz/ajsf-bootstrap5/*"
      ],
      "@stulz/ajsf-material": [
        "dist/stulz/ajsf-material"
      ],
      "@stulz/ajsf-material/*": [
        "dist/stulz/ajsf-material/*"
      ],
      "@stulz/ajsf-daisyui": [
        "dist/stulz/ajsf-daisyui"
      ],
      "@stulz/ajsf-daisyui/*": [
        "dist/stulz/ajsf-daisyui/*"
      ],
      "@stulz/ajsf-cssframework": [
        "dist/stulz/ajsf-cssframework"
      ],
      "@stulz/ajsf-cssframework/*": [
        "dist/stulz/ajsf-cssframework/*"
      ]
    },
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true
  }
}
